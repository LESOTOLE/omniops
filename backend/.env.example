# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000"

# Relational Database (MySQL via Prisma)
DATABASE_URL="mysql://username:password@localhost:3306/omniops_db"

# NoSQL Database (MongoDB Atlas / Local for Audit Logs)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/omniops_logs?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"
JWT_REFRESH_EXPIRES_IN="7d"
